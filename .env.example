# Copy to .env and adjust. Never commit the real .env.

APP_NAME=EventHub-KTPM
ENVIRONMENT=local

# PostgreSQL. Matches the development service defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://eventhub:eventhub-local-only@localhost:5432/eventhub_ktpm

# Destructive concurrency tests only. This must remain a dedicated disposable database.
TEST_DATABASE_URL=postgresql+psycopg://eventhub_test:eventhub_test@localhost:5433/eventhub_test_disposable

# Optional Docker Compose host-port overrides.
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
API_PORT=8000

# Connection pool. Deliberately small and explicit so Phase 2 can tune it and measure.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Create tables on startup instead of running Alembic. Handy for benchmarks/CI.
DB_AUTO_CREATE=false

# JWT. Production startup rejects this placeholder and secrets shorter than 32 characters.
# Replace it with a private value outside local development; never commit that value.
JWT_SECRET=change-me-in-production-this-is-a-local-only-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# bcrypt cost factor. 12 is a sane default; lowering it speeds up load tests but
# is NOT a production setting. Always report the value used alongside benchmark results.
BCRYPT_ROUNDS=12

# Automatic event-completion worker. Both values are bounded by application validation.
EVENT_COMPLETION_POLL_SECONDS=60
EVENT_COMPLETION_BATCH_SIZE=100
