# Copy to .env and adjust. Never commit the real .env.

APP_NAME=EventHub-KTPM
ENVIRONMENT=local

# PostgreSQL. Matches the service defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://eventhub:eventhub@localhost:5432/eventhub_ktpm

# Connection pool. Deliberately small and explicit so Phase 2 can tune it and measure.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Create tables on startup instead of running Alembic. Handy for benchmarks/CI.
DB_AUTO_CREATE=false

# JWT. MUST be replaced outside local development.
JWT_SECRET=change-me-in-production-this-is-a-local-only-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# bcrypt cost factor. 12 is a sane default; lowering it speeds up load tests but
# is NOT a production setting. Always report the value used alongside benchmark results.
BCRYPT_ROUNDS=12
